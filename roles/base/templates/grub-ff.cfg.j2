# Managed by Ansible role base. Applied only when ff_base_reboot=true.
# Mirrors interview tuning: isolcpus / nohz_full / rcu_nocbs on isolated cores.
GRUB_CMDLINE_LINUX_DEFAULT="${GRUB_CMDLINE_LINUX_DEFAULT} isolcpus=nohz,domain,managed_irq,{{ ff_isolated_cores | join(',') }} nohz_full={{ ff_isolated_cores | join(',') }} rcu_nocbs={{ ff_isolated_cores | join(',') }} irqaffinity={{ ff_os_cores[0] }} nowatchdog nosoftlockup skew_tick=1{% if cpu_vendor | default('') == 'intel' %} intel_idle.max_cstate=1{% endif %}"
