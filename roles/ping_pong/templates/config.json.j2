{% set hw = ff_hw_concurrency | int %}
{% set core = ff_isolated_cores[item.pin_slot | int] | int %}
{% set mask = ('0' * core) ~ '1' ~ ('0' * (hw - core - 1)) %}
{% set listen = item.listen | default(':19090') %}
{% if item.peer_host is defined %}
{% set peer = hostvars[item.peer_host].ff_private_ip | default(hostvars[item.peer_host].ansible_host) %}
{% set peer_addr = peer ~ (listen if listen.startswith(':') else ':' ~ (listen.split(':')[-1])) %}
{% elif item.peer_addr is defined %}
{% set peer_addr = item.peer_addr %}
{% else %}
{% set peer_addr = '127.0.0.1' ~ (listen if listen.startswith(':') else ':19090') %}
{% endif %}
{
  "name": "{{ item.role }}",
  "logger": {
    "log_path": "{{ ff_log_dir }}/log_{{ item.role }}.txt",
    "log_level": "info",
    "max_files": 3,
    "backtrace_size": 0
  },
  "service_thread_mask": "{{ mask }}",
  "aux_thread_mask": "",
  "meta_models": [
{% if item.role == 'pong' %}
    { "meta_model_id": "PONG", "is_server": true },
    { "meta_model_id": "PING", "is_server": false }
{% else %}
    { "meta_model_id": "PING", "is_server": true },
    { "meta_model_id": "PONG", "is_server": false }
{% endif %}
  ],
  "model_id": "{{ item.role | upper }}",
  "meta_config": {
    "role": "{{ item.role }}",
    "frequency_us": {{ item.frequency_us | default(100) }},
    "listen": "{{ listen }}",
    "peer_addr": "{{ peer_addr }}"
{% if item.role == 'ping' %}
    ,"statistic_wait_ms": {{ item.statistic_wait_ms | default(1000) }}
    ,"statistic_window_ms": {{ item.statistic_window_ms | default(10000) }}
    ,"log_info_stat": {{ item.log_info_stat | default(true) | bool | lower }}
{% endif %}
  }
}
