{% set hw = ff_hw_concurrency | int %}
{% set core = ff_isolated_cores[item.pin_slot | int] | int %}
{% set mask = ('0' * core) ~ '1' ~ ('0' * (hw - core - 1)) %}
{% set shm_path = item.shm_path | default(ff_shm_path) %}
{
  "name": "{{ item.role }}",
  "logger": {
    "log_path": "{{ ff_log_dir }}/log_{{ item.role }}.txt",
    "log_level": "info",
    "max_files": 3,
    "backtrace_size": 0
  },
  "service_thread_mask": "{{ mask }}",
  "aux_thread_mask": "",
  "meta_models": [
{% if item.role == 'pong' %}
    { "meta_model_id": "PONG", "is_server": true },
    { "meta_model_id": "PING", "is_server": false }
{% else %}
    { "meta_model_id": "PING", "is_server": true },
    { "meta_model_id": "PONG", "is_server": false }
{% endif %}
  ],
  "model_id": "{{ item.role | upper }}",
  "meta_config": {
    "role": "{{ item.role }}",
    "frequency_us": {{ item.frequency_us | default(100) }},
    "shm_path": "{{ shm_path }}"
{% if item.role == 'ping' %}
    ,"statistic_wait_ms": {{ item.statistic_wait_ms | default(1000) }}
    ,"statistic_window_ms": {{ item.statistic_window_ms | default(10000) }}
    ,"log_info_stat": {{ item.log_info_stat | default(true) | bool | lower }}
{% endif %}
  }
}
